<?xml version="1.0"?>
<package format="3">
  <name>hand_eye_calibration</name>
  <version>2.0.0</version>
  <description>Robust ROS 2 hand-eye calibration with synchronized capture and a Qt workflow.</description>
  <maintainer email="ilya.vdovets@gmail.com">vdovetzi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <depend>ros_babel_fish</depend>
  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>
  <depend>rviz_rendering</depend>
  <depend>libopencv-dev</depend>
  <depend>libopencv-contrib-dev</depend>
  <depend>boost</depend>
  <depend>qtbase5-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
